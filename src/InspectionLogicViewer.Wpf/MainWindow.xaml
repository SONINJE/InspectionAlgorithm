<Window x:Class="InspectionLogicViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspection Logic Viewer" Width="1400" Height="850"
        Background="White" FontFamily="Segoe UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center" Height="36">
            <Button Content="이미지 열기" Width="110" Margin="0,0,8,0" Click="OpenImage_Click" Background="#FFF" BorderBrush="#DDD"/>
            <Button Content="검사" Width="90" Margin="0,0,8,0" Click="Inspect_Click" Background="#FFF" BorderBrush="#DDD"/>
            <Button Content="이전" Width="80" Margin="0,0,8,0" Click="Previous_Click" Background="#FFF" BorderBrush="#DDD"/>
            <Button Content="다음" Width="80" Margin="0,0,12,0" Click="Next_Click" Background="#FFF" BorderBrush="#DDD"/>
            <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ThresholdBox" Text="35" Width="60" Margin="0,0,12,0"/>

            <Button Content="파라미터..." Width="110" Click="OpenParamsDialog_Click" Margin="0,0,12,0" Background="#FFF" BorderBrush="#DDD"/>
            <Button Content="Crop 표시" Width="100" Click="Crop_Show_Click" Margin="0,0,12,0" Background="#FFF" BorderBrush="#DDD"/>

            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="이미지를 열어주세요." Foreground="#444"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: LogicCanvas (MAP) — 스타일 개선 -->
            <Border Grid.Column="0" BorderBrush="#E6E9EE" BorderThickness="1" Margin="0,0,8,0" Background="#FFFFFF" CornerRadius="8" Padding="8" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="LogicScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              PreviewMouseWheel="LogicScroll_PreviewMouseWheel">
                    <Canvas x:Name="LogicCanvas" Width="960" Height="600" Background="#FBFCFD"/>
                </ScrollViewer>
            </Border>

            <!-- CENTER: 불량 목록 -->
            <Border Grid.Column="1" BorderBrush="#E6E9EE" BorderThickness="1" Margin="0,0,8,0" Background="#FFFFFF" CornerRadius="8" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Defect List" FontSize="16" FontWeight="SemiBold" Margin="6"/>
                    <ListBox x:Name="DefectList" SelectionChanged="DefectList_SelectionChanged" Margin="6" FontSize="13" Padding="4"/>
                </DockPanel>
            </Border>

            <!-- RIGHT: LogicTree + 검사 이미지 + Crop Preview + MiniMap -->
            <Border Grid.Column="2" BorderBrush="#E6E9EE" BorderThickness="1" Background="#FFFFFF" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Text="Logic Tree" FontSize="16" FontWeight="SemiBold" Margin="6"/>
                        <ScrollViewer>
                            <TreeView x:Name="LogicTreeView" Margin="6"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- 이미지 패널: Image 위에 Canvas 오버레이로 ROI 표현 -->
                    <Grid Grid.Row="1" Margin="4" x:Name="ImagePanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="검사 이미지" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Background="Transparent" ClipToBounds="True" CornerRadius="4" BorderBrush="#F0F2F4" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="ImageView"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                    <Canvas x:Name="ImageOverlayCanvas" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 오른쪽 작은 패널: Cropped Preview + MiniMap -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Cropped Preview" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Border Height="120" Background="#FFF" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4">
                                <Image x:Name="CropPreview" Stretch="Uniform" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Feature" Margin="0,0,8,0" FontFamily="Segoe UI">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Rows 속성 제거: UniformGrid가 항목 수에 맞춰 자동 배치합니다 -->
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <TextBlock Text="X" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Fx" FontSize="13" Margin="4"/>
                            <TextBlock Text="Y" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Fy" FontSize="13" Margin="4"/>
                            <TextBlock Text="Width" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Fw" FontSize="13" Margin="4"/>
                            <TextBlock Text="Height" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Fh" FontSize="13" Margin="4"/>
                            <TextBlock Text="Area" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Farea" FontSize="13" Margin="4"/>
                            <TextBlock Text="Mean" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Fmean" FontSize="13" Margin="4"/>
                            <TextBlock Text="Aspect" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Faspect" FontSize="13" Margin="4"/>
                            <TextBlock Text="Type (Name)" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Ftype" FontSize="13" Margin="4"/>
                            <TextBlock Text="Type (Code)" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FDefectCode" FontSize="13" Margin="4"/>
                            <TextBlock Text="IsDark" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FIsDark" FontSize="13" Margin="4"/>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,0">
                            <TextBlock Text="IsLinear" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FIsLinear" FontSize="13" Margin="4"/>
                            <TextBlock Text="AreaRatio" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FareaRatio" FontSize="13" Margin="4"/>
                            <TextBlock Text="Circularity" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="Fcircularity" FontSize="13" Margin="4"/>
                            <TextBlock Text="Angle (deg)" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FangleDeg" FontSize="13" Margin="4"/>
                            <TextBlock Text="PeakMax" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FpeakMax" FontSize="13" Margin="4"/>
                            <TextBlock Text="AreaObjPercent" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FareaObjPercent" FontSize="13" Margin="4"/>
                            <TextBlock Text="RatioMopol" Margin="4" VerticalAlignment="Center"/><TextBlock x:Name="FratioMopol" FontSize="13" Margin="4"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <Border Grid.Column="1" Background="#FAFBFC" BorderBrush="#EEE" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="파라미터는 '파라미터...' 버튼으로 열립니다." FontStyle="Italic" Foreground="#666"/>
                    <TextBlock Text="선택된 불량의 크롭 프리뷰와 미니맵이 우측에 표시됩니다." Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>