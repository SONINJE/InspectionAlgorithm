<Window x:Class="InspectionLogicViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspection Logic Viewer" Width="1440" Height="880" MinWidth="1180" MinHeight="700"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="270"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="LOAD" Width="100" Style="{StaticResource PrimaryButton}" Click="OpenImage_Click"/>
                <Button Content="INSPECT" Width="100" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Inspect_Click"/>
                <Border Width="1" Height="22" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>
                <Button Content="◀ BACK" Width="86" Click="Previous_Click"/>
                <Button Content="NEXT ▶" Width="86" Margin="8,0,0,0" Click="Next_Click"/>
                <Border Width="1" Height="22" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>
                <Button Content="파라미터" Width="92" Click="OpenParamsDialog_Click"/>
                <Border Width="1" Height="22" Background="{StaticResource CardBorderBrush}" Margin="12,0"/>

                <TextBlock Text="표면 종류" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="SurfaceTypeCombo" Width="110" Height="30" VerticalContentAlignment="Center"
                          SelectionChanged="SurfaceTypeCombo_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="코팅부"/>
                    <ComboBoxItem Content="무지부"/>
                    <ComboBoxItem Content="절연부"/>
                </ComboBox>
                <CheckBox x:Name="InsulGapCheck" Content="절연 Gap 영역" VerticalAlignment="Center" Margin="10,0,0,0"
                          Visibility="Collapsed" Checked="InsulGapCheck_Changed" Unchecked="InsulGapCheck_Changed"/>

                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="이미지를 열어주세요." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: LogicCanvas (MAP) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="10" SnapsToDevicePixels="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBlock Text="Logic Map" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="드래그로 이동 · 휠로 확대/축소" FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="FitViewBtn" Content="전체보기" Width="76" Height="26" FontSize="11" Click="FitView_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource SubtleBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <ScrollViewer x:Name="LogicScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      PreviewMouseWheel="LogicScroll_PreviewMouseWheel">
                            <Canvas x:Name="LogicCanvas" Width="960" Height="600" Background="Transparent"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

            <!-- CENTER: 불량 목록 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Defect List" Style="{StaticResource SectionHeader}"/>
                    <ListBox x:Name="DefectList" SelectionChanged="DefectList_SelectionChanged" FontSize="12.5"/>
                </DockPanel>
            </Border>

            <!-- RIGHT: 파라미터 요약 + 검사 이미지 + Crop Preview -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="파라미터" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <Button x:Name="OpenParamsFromPanelBtn" Content="변경..." Width="72" Height="24"
                                    FontSize="11" HorizontalAlignment="Right" Click="OpenParamsDialog_Click"/>
                        </Grid>

                        <ScrollViewer CanContentScroll="False">
                            <UniformGrid Columns="2" x:Name="ParamSummaryGrid"/>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- 이미지 패널: Image 위에 Canvas 오버레이로 ROI 표현 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0" x:Name="ImagePanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="검사 이미지" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource SubtleBackgroundBrush}" ClipToBounds="True" CornerRadius="8"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="ImageView"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                    <Canvas x:Name="ImageOverlayCanvas" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 오른쪽 작은 패널: Cropped Preview -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cropped Preview" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Height="120" Background="{StaticResource SubtleBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Image x:Name="CropPreview" Stretch="Uniform" Margin="4"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Feature" Margin="0,0,10,0" FontFamily="Segoe UI">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <TextBlock Text="X" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fx" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Y" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fy" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Width" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fw" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Height" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fh" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Area" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Farea" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Mean" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fmean" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Aspect (W/H)" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Faspect" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Ratio (장/단축)" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fratio" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Size (실측 X x Y)" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fsize" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Type (Name)" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Ftype" FontSize="13" Margin="4" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Type (Code)" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FDefectCode" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="IsDark" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FIsDark" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,0">
                            <TextBlock Text="IsLinear" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FIsLinear" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Circularity" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="Fcircularity" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="Angle (deg)" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FangleDeg" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="PeakMax" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FpeakMax" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="AreaObjPercent" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FareaObjPercent" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                            <TextBlock Text="RatioMopol" Margin="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="FratioMopol" FontSize="13" Margin="4" FontWeight="SemiBold"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- Logic Tree + 여유값 범례 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock DockPanel.Dock="Top" Text="Logic Tree" Style="{StaticResource SectionHeader}"/>
                        <!-- TreeView는 자체 ScrollViewer를 내장하고 있어 바깥에 또 ScrollViewer로 감싸면
                             안쪽 스크롤러가 높이를 무제한으로 받아 휠 스크롤이 먹히지 않는다. 그대로 채운다. -->
                        <TreeView x:Name="LogicTreeView"/>
                    </DockPanel>

                    <!-- 여유값(Margin) 색상 범례 -->
                    <Border Grid.Column="1" Background="{StaticResource SubtleBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="10" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="여유값 범례" FontWeight="SemiBold" FontSize="11.5"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="10" Height="10" Background="{StaticResource DangerBrush}" CornerRadius="3" Margin="0,0,7,0"/>
                                <TextBlock Text="5% 미만" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="10" Height="10" Background="{StaticResource WarningBrush}" CornerRadius="3" Margin="0,0,7,0"/>
                                <TextBlock Text="15% 미만" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" Background="{StaticResource SuccessBrush}" CornerRadius="3" Margin="0,0,7,0"/>
                                <TextBlock Text="충분한 여유" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
