<Window x:Class="InspectionLogicViewer.Wpf.ParamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameters" Width="460" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="파라미터 설정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <UniformGrid Columns="2" Rows="13" Margin="0,0,0,6">
                    <TextBlock Text="Dark_면적비율" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_FormMinAreaRatio" Margin="4"/>
                    <TextBlock Text="Dark_진원도" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_Roundness" Margin="4"/>
                    <TextBlock Text="Dark_면적비율" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_DarkAreaPercent" Margin="4"/>
                    <TextBlock Text="Dark_최소밝기" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_LinearBaseBright" Margin="4"/>
                    <TextBlock Text="Dark_기울기 하한" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_LineAngleLow" Margin="4"/>
                    <TextBlock Text="Dark_기울기 상한" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_LineAngleHigh" Margin="4"/>
                    <TextBlock Text="White_핀홀 기준값(피크)" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_WhitePeakIf" Margin="4"/>
                    <TextBlock Text="White_돌출 기준값(피크)" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_WhitePeakElseIf" Margin="4"/>
                    <TextBlock Text="White_라인성 비율" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_WhiteRatio" Margin="4"/>
                    <TextBlock Text="White_라인 기준값(피크)" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_WhiteLinePeak" Margin="4"/>
                    <TextBlock Text="선형성 비율" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_LinearityRatio" Margin="4"/>
                    <TextBlock Text="최소 불량 크기" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_AreaMin" Margin="4"/>
                    <TextBlock Text="모폴로지 연산횟수" VerticalAlignment="Center" Margin="4"/> <TextBox x:Name="Txt_NdilCnt" Margin="4"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Load JSON" Width="90" Margin="0,0,8,0" Click="LoadJson_Click"/>
            <Button Content="Save JSON" Width="90" Margin="0,0,8,0" Click="SaveJson_Click"/>
            <Button Content="OK" Width="90" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>