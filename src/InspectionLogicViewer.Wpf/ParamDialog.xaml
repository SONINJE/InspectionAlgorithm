<Window x:Class="InspectionLogicViewer.Wpf.ParamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파라미터 설정" Width="480" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="파라미터 설정" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="검사 실행 임계값과, 판정 로직 설명(다이어그램)에 사용되는 기준값입니다." FontSize="11.5"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ParamFieldsHost"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Content="JSON 불러오기" Width="112" Style="{StaticResource GhostButton}" Click="LoadJson_Click"/>
                <Button Content="JSON 저장" Width="96" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="SaveJson_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1">
                <Button Content="취소" Width="84" Style="{StaticResource GhostButton}" IsCancel="True"/>
                <Button Content="확인" Width="96" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
